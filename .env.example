# Copy this file to .env and fill in your values.

# Required. GitHub Personal Access Token.
# Create one at https://github.com/settings/tokens
#   - Classic token: check the "repo" scope (needed for private repos).
#     If the repo is public, "public_repo" is enough.
#   - Also check "read:org" so the app can list org members for the
#     assignee filter in the UI.
#   - If you are in an organization with SSO enabled, remember
#     to click "Configure SSO" / "Authorize" next to the token afterwards.
GITHUB_TOKEN=

# Required. The repo to track.
GITHUB_OWNER=
GITHUB_REPO=

# Optional. GitHub login pre-selected in the assignee picker on first load
# (only applies until you pick something yourself — after that your choice
# is remembered in the browser instead).
GITHUB_DEFAULT_ASSIGNEE=

# Optional. Port for the local server.
PORT=8030

# Optional. Set to "false" to stop the server from auto-opening your
# default browser on startup.
OPEN_BROWSER=true

# The search query itself is no longer set here — edit it directly in the
# page (text box + assignee picker), it's just held in the browser.
